{
  "$schema": "https://modelcontextprotocol.io/schema/mcp.json",
  "inputs": [
    {
      "id": "cloudinaryApiKey",
      "type": "promptString",
      "description": "Cloudinary API key. Paste the value of CLOUDINARY_API_KEY from .env.local. Stored in VS Code secret storage after first entry — you'll only be asked once per machine.",
      "password": true
    },
    {
      "id": "cloudinaryApiSecret",
      "type": "promptString",
      "description": "Cloudinary API secret. Paste the value of CLOUDINARY_API_SECRET from .env.local. Stored in VS Code secret storage after first entry — you'll only be asked once per machine.",
      "password": true
    },
    {
      "id": "neonApiKey",
      "type": "promptString",
      "description": "Neon API key. Paste the value of NEON_API_KEY from .env.local. Stored in VS Code secret storage after first entry — you'll only be asked once per machine.",
      "password": true
    },
    {
      "id": "vercelToken",
      "type": "promptString",
      "description": "Vercel API token. Paste the value of VERCEL_TOKEN from .env.local. Stored in VS Code secret storage after first entry — you'll only be asked once per machine.",
      "password": true
    }
  ],
  "servers": {
    "shadcn": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "shadcn@latest", "mcp"]
    },
    "next-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "next-devtools-mcp@latest"]
    },
    "cloudinary": {
      "type": "sse",
      "url": "https://asset-management.mcp.cloudinary.com/mcp",
      "headers": {
        "cloudinary-cloud-name": "devhasibulislam",
        "cloudinary-api-key": "${input:cloudinaryApiKey}",
        "cloudinary-api-secret": "${input:cloudinaryApiSecret}"
      }
    },
    "neon": {
      "type": "http",
      "url": "https://mcp.neon.tech/mcp",
      "headers": {
        "Authorization": "Bearer ${input:neonApiKey}"
      }
    },
    "vercel": {
      "type": "http",
      "url": "https://mcp.vercel.com",
      "headers": {
        "Authorization": "Bearer ${input:vercelToken}"
      }
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest"]
    }
  }
}
