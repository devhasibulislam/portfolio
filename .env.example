# -----------------------------------------------------------------------------
# Environment schema. Copy this file to .env.local and fill in real values.
#   cp .env.example .env.local
# See docs/BUILD_PLAN.md → "Resume from another device" for provisioning steps.
# -----------------------------------------------------------------------------

# --- Neon Postgres --------------------------------------------------------
# Pooled connection string ONLY (must contain "-pooler" in the host).
# Console: https://console.neon.tech → project → Connection Details → Pooled.
DATABASE_URL=''

# --- Neon Management API --------------------------------------------------
# Personal API key for the optional dashboard stats widget.
# Console: https://console.neon.tech → account settings → API keys.
NEON_API_KEY=''

# Project ID for the dashboard analytics widget. Copy from the Neon Console
# project URL (e.g. "square-cherry-12602297"). Leave blank to hide the widget.
NEON_PROJECT_ID=''

# --- Neon Auth (Managed Better Auth) --------------------------------------
# Enable Auth: Neon Console → project → branch → Auth → Enable, then
# Configuration tab → copy the Auth URL.
NEON_AUTH_BASE_URL=''

# 32+ char random secret. Generate with:  openssl rand -base64 48
NEON_AUTH_COOKIE_SECRET=''

# --- Single-user dashboard whitelist --------------------------------------
# Only this email is allowed into /dashboard, even if Neon Auth would let others in.
DASHBOARD_ALLOWED_EMAIL=''

# --- Seed user (consumed by `npm run seed:user`, one-off) -----------------
# Used only by scripts/seed-user.ts to create the sole dashboard user with a
# real password (the Neon Console UI cannot set passwords).
SEED_USER_NAME=''
SEED_USER_PASSWORD=''

# --- Cloudinary -----------------------------------------------------------
# https://console.cloudinary.com → Dashboard → Access Keys.
CLOUDINARY_CLOUD_NAME=''
CLOUDINARY_API_KEY=''
CLOUDINARY_API_SECRET=''
# Public — safe to expose. Used by <CldImage> / client uploader.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=''

# --- Vercel ---------------------------------------------------------------
# https://vercel.com/account/tokens
VERCEL_TOKEN=''
# Team and project IDs consumed by the dashboard Vercel-analytics widget.
# Copy from Vercel → Team → Settings → General, and Project → Settings → General.
VERCEL_TEAM_ID=''
VERCEL_PROJECT_ID=''

# --- Google PageSpeed Insights (Lighthouse-as-a-service) ------------------
# https://developers.google.com/speed/docs/insights/v5/get-started
# Create a key: https://console.cloud.google.com/apis/credentials
PAGESPEED_API_KEY=''

# --- Site -----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL='http://localhost:3000'
NEXT_PUBLIC_CLOUDINARY_API_KEY=your-cloudinary-key

# --- Appwrite (reserved for future Neon → Appwrite fallback) --------------
# https://cloud.appwrite.io → project → Settings → API endpoint & Project ID.
# All three are safe to expose (NEXT_PUBLIC_*); no secret key here.
NEXT_PUBLIC_APPWRITE_PROJECT_ID=''
NEXT_PUBLIC_APPWRITE_PROJECT_NAME=''
NEXT_PUBLIC_APPWRITE_ENDPOINT=''
